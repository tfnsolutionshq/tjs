APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Mobile / external JSON API (/api/v1/*)
API_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Documents (PDFs, submissions) and public media (covers, logos, avatars).
# Use "s3" to store new uploads in S3. Existing local files still resolve.
DOCUMENTS_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TJS / Paystack (https://dashboard.paystack.com/#/settings/developers)
# Use test keys (sk_test_… / pk_test_…) in local; live keys in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Optional override (defaults to https://api.paystack.co)
# PAYSTACK_BASE_URL=https://api.paystack.co
#
# After payment, Paystack redirects to: {APP_URL}/payments/callback
# Set webhook URL in Paystack dashboard to: {APP_URL}/paystack/webhook
# Journals using a personal gateway must set the same webhook URL in their own Paystack dashboard.
# Optional default platform share when journals use split/subaccount (overridden in Admin → Settings):
# TJS_PAYMENTS_SPLIT_FEE_PERCENT=0
# (local testing: use ngrok / cloudflared so Paystack can reach your machine)

TJS_NAME=TJS
TJS_FULL_NAME="TFN Journal System"
TJS_ORG="Turbo Flux Network Solutions"
TJS_PUBLISHER="Turbo Flux Network Solutions"
TJS_DEVELOPER_NAME=TFNSolutions
TJS_DEVELOPER_URL=https://tfnsolutions.us
# Platform support for journal managers (split codes, billing help, etc.)
# TJS_SUPPORT_EMAIL=support@tfnsolutions.us
# TJS_SUPPORT_PHONE=
TJS_CURRENCY=NGN
TJS_PLATFORM_MEMBERSHIP_PRICE=15000
TJS_PLATFORM_MEMBERSHIP_DAYS=365
# Optional: set to false to hide platform membership purchases
# TJS_PLATFORM_MEMBERSHIP_ENABLED=true
# Journal listing / management unlock fee (NGN by default)
TJS_JOURNAL_ACTIVATION_PRICE=50000
TJS_JOURNAL_ACTIVATION_DAYS=365
# Optional: set to false to waive fees for newly created journals
# TJS_JOURNAL_ACTIVATION_ENABLED=true

# DOI / Crossref (platform pool + journal own credentials)
# TJS_DOI_ENABLED=true
# TJS_DOI_USD_TO_NGN=2000
# TJS_DOI_CREDIT_PRICE_USD=1
# TJS_DOI_THRESHOLD_ABSOLUTE=20
# TJS_DOI_THRESHOLD_PERCENT=10
# TJS_DOI_PREFIX=10.0000/tjs
# CROSSREF_USERNAME=
# CROSSREF_PASSWORD=
# CROSSREF_DEPOSIT_URL=https://doi.crossref.org/servlet/deposit
# CROSSREF_DEPOSITOR_NAME="Turbo Flux Network Solutions"
# CROSSREF_DEPOSITOR_EMAIL=doi@example.com

# Optional: path to tesseract.exe for scanned PDF/image OCR on article extract
# TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

